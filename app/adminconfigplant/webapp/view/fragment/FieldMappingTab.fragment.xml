<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <!-- PROSPETTO DI SOLA LETTURA. La tabella elenca le corrispondenze fra campi SAP e campi Plex
         delle quattro aree in perimetro. Le righe stanno in model/fieldMappings.json, il binding e'
         ASSOLUTO ({fieldMap>/FieldMappings}): il prospetto e' lo stesso per ogni plant e non dipende
         dal plant aperto.

         NON E' LA MAPPATURA APPLICATA. Quella e' customizing per plant, su OData, e vive nelle schede
         «Mappatura Part Plex» (ZPlexFieldMap) e «Mappatura Operazioni Plex» (ZPlexOpFieldMap), con
         valore fisso, campo SAP o regole a condizioni. Per questo qui non si modifica niente: nessun
         controllo editabile, nessun handler, nessuna toolbar. Un campo digitabile su un prospetto che
         non guida l'integrazione e' esattamente il difetto che la W1-23 ha chiuso.

         La colonna «Attivo» riusa formatActiveText/formatActiveState di PlantConfig.controller.js,
         gli stessi di MaterialCategoriesTab: targetType 'any' e' obbligatorio, il valore e' booleano. -->
    <Panel headerText="{i18n>tabFieldMapping}" class="sapUiSmallMargin">

        <Table
            items="{fieldMap>/FieldMappings}"
            growing="true"
            growingThreshold="50">

            <columns>
                <Column width="10%">
                    <Text text="{i18n>fmColObject}"/>
                </Column>
                <Column width="14%">
                    <Text text="{i18n>fmColSapField}"/>
                </Column>
                <Column width="18%">
                    <Text text="{i18n>fmColSapDesc}"/>
                </Column>
                <Column width="16%">
                    <Text text="{i18n>fmColPlexField}"/>
                </Column>
                <Column width="16%">
                    <Text text="{i18n>fmColPlexDesc}"/>
                </Column>
                <Column width="14%">
                    <Text text="{i18n>fmColTransform}"/>
                </Column>
                <Column width="8%" hAlign="Center">
                    <Text text="{i18n>fmColActive}"/>
                </Column>
            </columns>

            <items>
                <ColumnListItem>
                    <cells>
                        <Text text="{fieldMap>object}"/>
                        <Text text="{fieldMap>sapField}"/>
                        <Text text="{fieldMap>sapDesc}"/>
                        <Text text="{fieldMap>plexField}"/>
                        <Text text="{fieldMap>plexDesc}"/>
                        <Text text="{fieldMap>transform}"/>
                        <ObjectStatus
                            text="{ path: 'fieldMap>active', targetType: 'any', formatter: '.formatActiveText' }"
                            state="{ path: 'fieldMap>active', targetType: 'any', formatter: '.formatActiveState' }"/>
                    </cells>
                </ColumnListItem>
            </items>

        </Table>
    </Panel>

</core:FragmentDefinition>
