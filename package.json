{
  "name": "marsplm-sap2plex",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap-cloud-sdk/connectivity": "^4.4.0",
    "@sap-cloud-sdk/http-client": "^4.4.0",
    "@sap-cloud-sdk/resilience": "^3.26.4",
    "@sap-cloud-sdk/util": "^4.4.0",
    "@sap/cds": "^9",
    "@sap/xssec": "^4",
    "express": "^4",
    "nodemailer": "^9",
    "pdfkit": "0.19.1"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.1.3",
    "@sap/cds-dk": "^9",
    "mailparser": "^3",
    "smtp-server": "^3"
  },
  "scripts": {
    "start": "cds-serve",
    "build:mta": "mbt build -t gen --mtar marsplm-sap2plex.mtar",
    "deploy:mta": "cf deploy gen/marsplm-sap2plex.mtar --retries 1",
    "deploy": "npm run build:mta && npm run deploy:mta",
    "watch-marsplm-sap2plex": "cds watch --open avvaleplm.marsplm.sap2plex.marsplmsap2plex/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-marsplm-sap2plex-hybrid": "cds watch --profile hybrid --open avvaleplm.marsplm.sap2plex.marsplmsap2plex/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-adminconfigmatfil": "cds watch --open avvaleplm.marsplm.sap2plex.adminconfigmatfil/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-adminconfprodtype": "cds watch --open avvaleplm.marsplm.sap2plex.adminconfprodtype/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-adminconfobjgrp": "cds watch --open avvaleplm.marsplm.sap2plex.adminconfobjgrp/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-adminconfigplant": "cds watch --open avvaleplm.marsplm.sap2plex.adminconfigplant/index.html?sap-ui-xx-viewCache=false --livereload false",
    "job-prod-order-confirmation": "node srv/jobs/postProdOrderConfirmation.js",
    "job-create-plex-orders": "node srv/jobs/createPlexProductionOrders.js",
    "job-sync-materials": "node srv/jobs/syncMaterialsToPlex.js",
    "job-sync-routings": "node srv/jobs/syncRoutingsToPlex.js",
    "job-prod-order-teco": "node srv/jobs/closeTecoPlexJobs.js",
    "job-order-complete": "node srv/jobs/completeSapOrdersFromPlex.js",
    "job-order-scheduled": "node srv/jobs/scheduleSapOrdersFromPlex.js",
    "seed-dev-plants": "node sample/seedDevPlants.js"
  },
  "private": true,
  "cds": {
    "features": {
      "app_services": {
        "impl": false
      }
    },
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "sap2plex.db"
        }
      },
      "auth": {
        "//": "[JOB-TRIGGER] Utente di SVILUPPO per collaudare gli endpoint /job-run (feature 0032). Il servizio JobRunService ha @requires:'JOBSCHEDULER' e quello scope, in cloud, e' concesso all'ISTANZA del Job Scheduling Service — non a una persona, quindi non esiste un role-template e nessun utente umano puo' averlo. In locale l'auth e' `mocked` e serve un utente che quel ruolo ce l'abbia, altrimenti ogni prova finisce in 403: curl -u jobsched:jobsched -X POST http://localhost:4004/job-run/runProdTeco. Vive nel profilo `development`: in produzione il kind e' xsuaa e questa sezione viene ignorata.",
        "[development]": {
          "users": {
            "jobsched": {
              "roles": [
                "JOBSCHEDULER"
              ]
            }
          }
        }
      },
      "[production]": {
        "auth": "xsuaa",
        "db": {
          "kind": "hana"
        },
        "connectivity": true,
        "destinations": true,
        "MARS_MAIL": {
          "mail": {
            "//": "[SMTP-MAIL] Il canale e' SMTP: i parametri stanno nella destination MARS_MAIL (Type=MAIL) e il codice li legge a runtime. Il default e' 'smtp' e non 'destination' perche' cosi' il canale parte DA SOLO il giorno in cui quella destination esiste: non c'e' nessun `cf set-env MAIL_TRANSPORT` da ricordarsi, tanto meno da ripetere su ogni task del Job Scheduler (le env non si ereditano, DEC-30). Finche' la destination non c'e' ogni run dichiara «SMTP non configurato: manca host...» su ZJobRunMail, che e' il messaggio giusto: prima falliva contro un /v1/mail/send mai esistito. Vedi DEC-93 e docs/CHECKLIST-CUSTOMIZING-PLANT.md §9.1.",
            "transport": "smtp"
          }
        }
      },
      "[hybrid]": {
        "db": {
          "kind": "hana"
        }
      },
      "destinations": true,
      "MARS_MAIL": {
        "kind": "rest",
        "credentials": {
          "destination": "MARS_MAIL"
        },
        "mail": {
          "transport": "file",
          "template": "flat",
          "path": "/v1/mail/send",
          "method": "POST",
          "requestTimeout": 20000,
          "fetchCsrfToken": false,
          "from": "noreply@marsplm.com",
          "maxAttachmentBytes": 4000000,
          "maxTotalBytes": 9000000,
          "pdf": true,
          "pdfMaxRows": 500,
          "csvMaxRows": 20000,
          "fields": {
            "to": "to",
            "cc": "cc",
            "from": "from",
            "subject": "subject",
            "html": "html",
            "text": "text",
            "attachments": "attachments",
            "attachmentName": "filename",
            "attachmentContentType": "contentType",
            "attachmentContent": "contentBase64"
          },
          "smtp": {
            "//": "[SMTP-MAIL] Solo valori NON segreti e non dipendenti dall'ambiente: questo file e' in git. host, porta, cifratura, utenza, password e mittente arrivano dalla DESTINATION MARS_MAIL (Type=MAIL) - e' la sorgente decisa col referente di infrastruttura. Le variabili MAIL_SMTP_* la scavalcano e servono allo sviluppo locale e alle emergenze: in produzione devono essere assenti, o la password finisce in `cf env` in chiaro. Vedi DEC-93 per la precedenza e docs/0010 per la mappa delle proprieta'.",
            "destination": "MARS_MAIL",
            "port": 587,
            "starttls": true,
            "pool": true,
            "maxMessages": 100,
            "timeoutMs": 20000,
            "tlsRejectUnauthorized": true,
            "allowPlaintext": false,
            "maxMessageBytes": null
          }
        }
      },
      "MARS_LICENSE": {
        "kind": "rest",
        "credentials": {
          "destination": "MARS_LICENSE"
        }
      },
      "OP_API_PRODUCTION_ORDER_2_SRV_0001": {
